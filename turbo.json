{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["package.json", "bun.lock", "bunfig.toml"],
  "globalPassThroughEnv": [
    "OPENPOST_ROOT_TASK_LOCKED",
    "OPENPOST_PARAGLIDE_PRECOMPILED",
    "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH",
    "VITEST_MAX_WORKERS"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": [],
      "env": ["OPENPOST_CHECK_PREPARED"]
    },
    "//#_policy": {
      "outputs": []
    },
    "lint:oxlint": {
      "outputs": []
    },
    "lint:svelte": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "test:server": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "@openpost/dither#build": {
      "outputs": ["dist/**"]
    },
    "@openpost/ui#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@openpost/ui#check": {
      "dependsOn": ["build", "^check"],
      "outputs": []
    },
    "//#_test:public-build": {
      "dependsOn": ["@openpost/docs#build", "@openpost/site#build"],
      "inputs": [
        "tests/build/generate-agent-surfaces.test.mjs",
        "scripts/**",
        "docs/**",
        "apps/server/**",
        "apps/cli/**",
        ".oxfmtrc.json",
        "apps/web/.oxfmtrc.json"
      ],
      "outputs": [],
      "env": [
        "CF_PAGES",
        "CF_PAGES_BRANCH",
        "CF_PAGES_COMMIT_SHA",
        "GITHUB_RUN_ID",
        "GITHUB_SHA",
        "OPENPOST_RELEASE_VERSION",
        "POSTHOG_PROJECT_ID",
        "POSTHOG_SOURCEMAPS_ENABLED",
        "POSTHOG_UI_HOST",
        "VITE_OPENPOST_ENVIRONMENT",
        "VITE_OPENPOST_REVISION",
        "VITE_OPENPOST_VERSION",
        "VITE_POSTHOG_API_HOST",
        "VITE_POSTHOG_PROJECT_TOKEN",
        "VITE_POSTHOG_UI_HOST"
      ],
      "passThroughEnv": ["POSTHOG_PERSONAL_API_KEY"]
    }
  }
}
